{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/globalSetup.ts",
  "setupFilesAfterEnv": ["<rootDir>/tests/e2e/setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 30000,
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json"
    }
  }
}
